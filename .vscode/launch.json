{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SmartBorrow: Streamlit + SQLite",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--server.headless=true",
        "--server.port=8502"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUTF8": "1"
      }
    },
    {
      "name": "SmartBorrow: ตรวจการเชื่อม SQLite",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/check_sqlite.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUTF8": "1"
      }
    }
  ]
}
